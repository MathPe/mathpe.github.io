---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = posts.slice(0, 4);
---
<!doctype html>
<html lang="fr">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <span class="eyebrow">Physique · Chimie · Curiosité</span>
        <h1 id="hero-title">Comprendre le monde, une idée à la fois.</h1>
        <p>Des articles de vulgarisation pour explorer les phénomènes qui nous entourent, des particules aux réactions chimiques — avec des explications claires et des sources à consulter.</p>
        <div class="hero-actions">
          <a class="button" href="/blog/">Parcourir les articles</a>
          <a class="button button-secondary" href="/about/">À propos du projet</a>
        </div>
      </section>

      <section aria-labelledby="recent-title">
        <h2 id="recent-title">Derniers articles</h2>
        {latestPosts.length > 0 ? (
          <ul class="article-list">
            {latestPosts.map((post) => (
              <li class="article-card">
                <a href={`/blog/${post.id}/`}>
                  <div class="article-meta"><span class="category">{post.data.category}</span><span><FormattedDate date={post.data.pubDate} /></span></div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty-state">Les premiers articles arrivent bientôt. Pour en ajouter un, crée un fichier Markdown dans <code>src/content/blog/</code>.</p>
        )}
      </section>
    </main>
    <Footer />
  </body>
</html>
