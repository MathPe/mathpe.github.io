---
import type { CollectionEntry } from 'astro:content';
import 'katex/dist/katex.min.css';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, category, heroImage } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <BaseHead title={`${title} | Sciences en clair`} description={description} />
    <style>
      .post-hero { width: 100%; max-height: 420px; margin: 1.5rem 0 2rem; object-fit: cover; border-radius: 1rem; }
      .updated { margin-left: .4rem; font-style: italic; }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <article>
        <header class="post-header">
          <div class="article-meta"><span class="category">{category}</span><span><FormattedDate date={pubDate} /></span>{updatedDate && <span class="updated">Mis à jour le <FormattedDate date={updatedDate} /></span>}</div>
          <h1>{title}</h1>
          <p class="post-description">{description}</p>
        </header>
        {heroImage && <img class="post-hero" src={heroImage.src} alt="" />}
        <div class="prose"><slot /></div>
      </article>
    </main>
    <Footer />
  </body>
</html>
